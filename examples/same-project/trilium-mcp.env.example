# Trilium's service name in this compose file, port 8080.
TRILIUM_SERVER_URL=http://trilium:8080

# Optional: enable OAuth login. Leave both empty for ETAPI tokens only.
# Public HTTPS address of this server, behind your reverse proxy.
MCP_BASE_URL=
# Encrypts stored logins. Generate once with: openssl rand -hex 32
MCP_OAUTH_SECRET=

# Optional: accept only these Host headers, comma-separated host[:port].
MCP_ALLOWED_HOSTS=

# Optional: set to true to also serve a ChatGPT Custom GPT Action.
CHATGPT_ACTIONS=
