# Public domains, both pointing at this host. Caddy serves Trilium's web UI
# on the first and the MCP server on the second.
TRILIUM_DOMAIN=trilium.example.com
MCP_DOMAIN=trilium-mcp.example.com

# Encrypts the stored OAuth logins. Generate once with: openssl rand -hex 32
# Changing it later signs every OAuth client out.
MCP_OAUTH_SECRET=

# Trilium image tag. Pin a release tag to control upgrades.
TRILIUM_VERSION=latest

# Where Trilium keeps its notes on this host.
TRILIUM_DATA_DIR=./trilium-data

# Optional: set to true to also serve a ChatGPT Custom GPT Action.
CHATGPT_ACTIONS=
