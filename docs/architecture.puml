@startuml architecture
!include theme.iuml
title Trilium ETAPI MCP — architecture

left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 130
skinparam defaultTextAlignment center

together {
    actor "App client, remote\n(OAuth — Trilium password,\nonce, in the browser)" as C0
    actor "Headless client, remote\n(ETAPI token)" as C1
    actor "Client on trusted LAN\n(ETAPI token)" as C2
}

rectangle "reverse proxy\n(TLS)" as Proxy #line:94A3B8;back:F8FAFC;text:64748B

rectangle "Docker host / compose network" as Host #F8FAFC {
    rectangle "trilium-mcp\n(this repo)\n:8081 /mcp" as MCP #line:4CA53E;back:98D486
    database "mcp-oauth\n(volume, encrypted)" as OAuthData
    rectangle "trilium\n:8080 /etapi" as Trilium
    database "trilium-data\n(volume)" as Data
}

C0 --> Proxy : HTTPS
C1 --> Proxy : HTTPS
C2 --> MCP : HTTP (LAN)
Proxy --> MCP : /mcp
MCP --> OAuthData : OAuth tokens
MCP --> Trilium : ETAPI
Trilium --> Data : notes

@enduml
